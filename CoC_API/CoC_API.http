@baseUrl = http://localhost:5062
@adminEmail = {{$processEnv COC_API_DEV_ADMIN_EMAIL}}
@adminPassword = {{$processEnv COC_API_DEV_ADMIN_PASSWORD}}
# Replace this with the ID returned by the Instagram campaign creation request.
@campaignId = 00000000-0000-0000-0000-000000000000

# Configure both Development admin environment variables before starting the API.
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# Only an authenticated admin can create users.
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Guilherme Conde",
  "email": "guilherme.conde@example.com",
  "password": "Password123!",
  "birthDate": "1990-01-01",
  "taxId": "123456789",
  "caracteristics": ["isAprovando"]
}

###
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Eduardo Fernando",
  "email": "eduardo.fernando@example.com",
  "password": "Password123!",
  "birthDate": "1990-01-01",
  "taxId": "987654321",
  "caracteristics": ["isAprovador"]
}

###
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "guilherme.conde@example.com",
  "password": "Password123!"
}

###
# The campaign owner is taken from the authenticated session.
POST {{baseUrl}}/campaigns
Content-Type: application/json

{
  "name": "Campanha de teste",
  "description": "Uma campanha para testar",
  "modelMsg": "Olá!",
  "type": "Email",
  "publicationDate": "2026-11-20T14:00:00Z",
  "imageUrl": null
}

###
# Replace the date with a future UTC time and the image URL with a public HTTPS image.
# This owner has isAprovando, so the campaign starts in InReview.
POST {{baseUrl}}/campaigns
Content-Type: application/json

{
  "name": "Instagram test campaign",
  "description": "A test campaign for Instagram publishing",
  "modelMsg": "Caption for a test publication",
  "type": "Instagram",
  "publicationDate": "2026-11-20T14:00:00Z",
  "imageUrl": "https://your-public-host.example/image.jpg"
}

###
# Log in as the reviewer account created above.
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "eduardo.fernando@example.com",
  "password": "Password123!"
}

###
PUT {{baseUrl}}/campaigns/{{campaignId}}/review/approve

###
# Log back in as the campaign owner to check the final status.
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "guilherme.conde@example.com",
  "password": "Password123!"
}

###
# Check after the scheduled time; the worker polls every 15 seconds.
GET {{baseUrl}}/campaigns/{{campaignId}}
